{
  "name": "unievent",
  "private": true,
  "description": "UniEvent monorepo: Next.js web (src/web) and NestJS API (src/api).",
  "workspaces": [
    "src/web",
    "src/api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @unievent/api",
    "dev:web": "npm run dev --workspace @unievent/web",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:cases": "node scripts/test-cases.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @unievent/api",
    "db:seed": "npm run db:seed --workspace @unievent/api",
    "db:reset": "npm run db:reset --workspace @unievent/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
